# À fusionner dans backend/.env.example (client LLM, issues #81 / #82 / #89)
LLM_BASE_URL=http://localhost:11434/v1   # Ollama ; sinon l'URL d'un fournisseur compatible OpenAI
LLM_MODEL=mistral
LLM_API_KEY=                             # vide pour Ollama ; ne JAMAIS committer une vraie clé
LLM_TIMEOUT_S=60
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRIES=3
LLM_STRUCTURED_OUTPUT=auto               # auto | json_schema | json_object | none
LLM_DEBUG_LOG_CONTENT=false              # logge prompts et réponses : debug local uniquement
