# Copy this file to .env and adjust the values.
# Never commit the .env file.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
BARAZA_ENV=development
BARAZA_LOG_LEVEL=INFO
# disabled | fake | vexa.
# disabled answers 503 on capture endpoints; fake is an explicit demo that never joins Meet;
# vexa starts the real bot and needs BARAZA_VEXA_API_KEY (see the Vexa profile below).
BARAZA_CAPTURE_MODE=disabled
# Browser origins accepted by the local API (JSON array).
BARAZA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Where people open the app: the links in notification emails point here.
BARAZA_PUBLIC_URL=http://localhost:3000

# Emails to the person who started a meeting (draft ready, generation failed). They hold the
# meeting title and a link, never any minutes text. Empty host: no email is sent.
# TLS is required unless BARAZA_SMTP_ALLOW_INSECURE=true (local test server only).
BARAZA_SMTP_HOST=
BARAZA_SMTP_PORT=587
BARAZA_SMTP_USER=
BARAZA_SMTP_PASSWORD=
BARAZA_SMTP_FROM="Baraza <no-reply@example.org>"
BARAZA_SMTP_STARTTLS=true
BARAZA_SMTP_SSL=false
BARAZA_SMTP_ALLOW_INSECURE=false

# ---------------------------------------------------------------------------
# Sign in (see docs/authentication.md). Create the first person with:
#   docker compose exec api python -m baraza.cli create-user --email you@example.org --name "You"
# ---------------------------------------------------------------------------
# false only for a local rehearsal; refused unless BARAZA_ENV=development.
BARAZA_AUTH_ENABLED=true
BARAZA_SESSION_TTL_DAYS=14
# Leave unset: secure cookies everywhere except development. true behind a TLS-ending proxy.
# BARAZA_COOKIE_SECURE=true
BARAZA_LOGIN_MAX_FAILURES=5
BARAZA_LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# Database and task queue
# ---------------------------------------------------------------------------
POSTGRES_USER=baraza
POSTGRES_PASSWORD=changeme
POSTGRES_DB=baraza
BARAZA_DATABASE_URL=postgresql+asyncpg://baraza:changeme@postgres:5432/baraza
BARAZA_REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Language model (OpenAI-compatible API)
# ---------------------------------------------------------------------------
# URL of the LiteLLM gateway, or directly of Ollama / vLLM / a hosted provider.
#   Local Ollama ("local" profile): http://ollama:11434/v1
BARAZA_LLM_BASE_URL=http://ollama:11434/v1
BARAZA_LLM_API_KEY=changeme
# Model name as expected by the gateway (e.g. mistral, llama3.1, gpt-4o-mini...).
BARAZA_LLM_MODEL=mistral
BARAZA_LLM_TIMEOUT_S=60
BARAZA_LLM_MAX_OUTPUT_TOKENS=2048
BARAZA_LLM_MAX_RETRIES=3
# auto | json_schema | json_object | none
BARAZA_LLM_STRUCTURED_OUTPUT=auto
# Logs prompts and answers: local debugging only.
BARAZA_LLM_DEBUG_LOG_CONTENT=false
# Set to true if the model runs at an external provider:
# the interface then shows it to administrators (GDPR).
BARAZA_LLM_IS_EXTERNAL=false

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# Retention period for transcripts and minutes, in days (0 = unlimited).
BARAZA_RETENTION_DAYS=0
# Delete the audio as soon as the transcript is produced.
BARAZA_DELETE_AUDIO_AFTER_TRANSCRIPTION=true

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Explicit browser-only fallback: fictional capture, transcript AND minutes.
# false exercises the backend; fake capture additionally needs BARAZA_CAPTURE_MODE=fake.
NEXT_PUBLIC_USE_MOCK_API=false

# ---------------------------------------------------------------------------
# Optional Vexa profile (see docs/vexa-backend.md)
# ---------------------------------------------------------------------------
BARAZA_VEXA_ENABLED=false
BARAZA_VEXA_BASE_URL=http://vexa:8056
# Get the scoped key after startup: docker compose exec vexa cat /run/vexa/key.env
BARAZA_VEXA_API_KEY=
BARAZA_VEXA_BOT_NAME="Baraza – note taker (transcribing)"
BARAZA_VEXA_TIMEOUT_SECONDS=15
BARAZA_VEXA_RETRIES=2
VEXA_DB_PASSWORD=change-vexa-db-password
VEXA_ADMIN_TOKEN=change-vexa-admin-token
VEXA_INTERNAL_SECRET=change-vexa-internal-secret
VEXA_WHISPER_MODEL=Systran/faster-whisper-small
VEXA_WHISPER_DEVICE=cpu
VEXA_WHISPER_COMPUTE_TYPE=int8
# Linux NVIDIA only: enable override, then change device=cuda / compute_type=float16.
# COMPOSE_FILE=docker-compose.yml:docker-compose.vexa-gpu.yml
