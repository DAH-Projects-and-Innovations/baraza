# Copy this file to .env and adjust the values.
# Never commit the .env file.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
BARAZA_ENV=development
BARAZA_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database and task queue
# ---------------------------------------------------------------------------
POSTGRES_USER=baraza
POSTGRES_PASSWORD=changeme
POSTGRES_DB=baraza
BARAZA_DATABASE_URL=postgresql+asyncpg://baraza:changeme@postgres:5432/baraza
BARAZA_REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Language model (OpenAI-compatible API)
# ---------------------------------------------------------------------------
# URL of the LiteLLM gateway, or directly of Ollama / vLLM / a hosted provider.
#   Local Ollama ("local" profile): http://ollama:11434/v1
BARAZA_LLM_BASE_URL=http://ollama:11434/v1
BARAZA_LLM_API_KEY=changeme
# Model name as expected by the gateway (e.g. mistral, llama3.1, gpt-4o-mini...).
BARAZA_LLM_MODEL=mistral
# Set to true if the model runs at an external provider:
# the interface then shows it to administrators (GDPR).
BARAZA_LLM_IS_EXTERNAL=false

# ---------------------------------------------------------------------------
# Privacy
# ---------------------------------------------------------------------------
# Retention period for transcripts and minutes, in days (0 = unlimited).
BARAZA_RETENTION_DAYS=0
# Delete the audio as soon as the transcript is produced.
BARAZA_DELETE_AUDIO_AFTER_TRANSCRIPTION=true

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# Simulate capture endpoints in the browser until the backend is ready (#105)
NEXT_PUBLIC_USE_MOCK_API=true

# ---------------------------------------------------------------------------
# Optional Vexa profile (see docs/vexa-backend.md)
# ---------------------------------------------------------------------------
BARAZA_VEXA_ENABLED=false
BARAZA_VEXA_BASE_URL=http://vexa:8056
# Get the scoped key after startup: docker compose exec vexa cat /run/vexa/key.env
BARAZA_VEXA_API_KEY=
BARAZA_VEXA_BOT_NAME="Baraza – note taker (transcribing)"
BARAZA_VEXA_TIMEOUT_SECONDS=15
BARAZA_VEXA_RETRIES=2
VEXA_DB_PASSWORD=change-vexa-db-password
VEXA_ADMIN_TOKEN=change-vexa-admin-token
VEXA_INTERNAL_SECRET=change-vexa-internal-secret
VEXA_WHISPER_MODEL=Systran/faster-whisper-small
VEXA_WHISPER_DEVICE=cpu
VEXA_WHISPER_COMPUTE_TYPE=int8
# Linux NVIDIA only: enable override, then change device=cuda / compute_type=float16.
# COMPOSE_FILE=docker-compose.yml:docker-compose.vexa-gpu.yml
